# FitCheck Admin — environment variables (all optional)

# Base URL of the FitCheck AI API. Leave empty for same-origin:
#   - dev:  Vite proxies /api -> http://localhost:8000
#   - prod: Netlify redirects /api/* -> https://api.fitcheckaiapp.com/api/:splat
VITE_API_BASE_URL=

# Sentry DSN for error monitoring. Empty disables Sentry entirely.
VITE_SENTRY_DSN=

# Supabase project URL + publishable (anon) key — enables "Continue with
# Google" on the login page (same project the main app uses). Set both or
# neither: when either is missing the Google button is hidden.
# Get them from: Supabase Dashboard > Settings > API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
