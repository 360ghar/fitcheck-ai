# FitCheck Admin — environment variables (all optional)

# Base URL of the FitCheck AI API. Leave empty for same-origin:
#   - dev:  Vite proxies /api -> http://localhost:8000
#   - prod: Netlify redirects /api/* -> https://api.fitcheckaiapp.com/api/:splat
VITE_API_BASE_URL=

# Sentry DSN for error monitoring. Empty disables Sentry entirely.
VITE_SENTRY_DSN=
