# Environment files
.env
.env.*
!.env.example

# macOS
.DS_Store

# Playwright MCP debug output
.playwright-mcp/

# Python
__pycache__/
*.py[cod]
*.log
backend/.venv/
backend/.pytest_cache/
frontend/.venv/
backend/logs/

# Node / Vite
node_modules/
dist/
frontend/node_modules/
frontend/dist/

# Supabase local
supabase/.branches/
supabase/.temp/
.zcode/

# Creative pipeline render cache (store/creative/**/*.png are the deliverables;
# this is the scratch HTML and content-hash ledger that makes a re-run incremental)
store/creative/.cache/
scripts/creative/node_modules/

# Rendered creative output. These are derived, and together they are ~1.5 GB:
#   frames/   redrawn by `node scripts/creative/render.mjs` from copy.json + fonts/
#   source/   captured by `flutter/scripts/capture_localized_screens.sh`
#   header/, search/, preview/  redrawn by the same renderer
# The inputs stay tracked (copy.json, manifest.json, fonts/) so a re-run
# reproduces byte-identical assets. Committing the output would put ~1.5 GB of
# binary into every clone for files no one edits by hand.
store/creative/frames/
store/creative/source/
store/creative/header/
store/creative/search/
store/creative/preview/

# Translation cache: regenerated by scripts/i18n/translate_*.py; the committed
# catalogs and keywords.json are the record, not the response cache.
store/asc/.translation-cache.json

# Per-run translation caches (16 MB of model responses). The catalogs and
# keywords.json are the record; these are resumable state, regenerated on demand.
flutter/lib/l10n/.translations.json
frontend/src/i18n/.translations.json
