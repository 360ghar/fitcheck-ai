# Supabase Configuration
# Get your publishable key from: Supabase Dashboard > Settings > API Keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# API base URL. Leave EMPTY (or omit) for the web app: the client then uses
# same-origin `/api/v1/...` paths, which the Vite proxy (dev) and the Netlify
# redirect (prod) route to the backend — no CORS preflights, no duplicate
# OPTIONS requests. Set a full origin (e.g. https://api.fitcheckaiapp.com)
# only for standalone builds that are NOT served behind a same-origin proxy.
# VITE_API_BASE_URL=
VITE_ENABLE_SOCIAL_IMPORT=true
# Gamification (streaks / achievements / leaderboard). Default OFF — nothing in
# the backend writes streaks, so the page can only ever render zeros. Off hides
# the nav entry and drops the /gamification route (a bookmark redirects to
# /dashboard). Read via FEATURES in src/lib/feature-flags.ts.
# Must be kept in step with the backend's ENABLE_GAMIFICATION by hand: there is
# no /config endpoint, so the web app cannot discover the server's flag.
VITE_ENABLE_GAMIFICATION=false
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry error tracking (optional — leave empty to disable)
VITE_SENTRY_DSN=
# Comma-separated emails allowed into /admin/blog (empty = DEV only)
VITE_BLOG_ADMIN_EMAILS=
