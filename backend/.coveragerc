; Coverage configuration for the backend test suite.
;
; The suite's contract (see docs/BACKEND.md → "Testing"):
;   `pytest` from backend/ runs everything AND enforces the coverage gate.
; Line and branch coverage must both stay >= 90% (coverage.py reports the
; combined total; the per-line and per-branch numbers are shown in the
; term-missing report so a regression in either is immediately visible).
;
; The gate is intentionally in fail_under here, not in pytest.ini addopts:
; `pytest --cov-fail-under=0` still works for a quick local iteration.

[run]
branch = True
source = app

[report]
fail_under = 90
show_missing = True
skip_covered = True
sort = Miss
exclude_lines =
    pragma: no cover
    if __name__ == "__main__":
    if TYPE_CHECKING:
    \.\.\.  ; ellipsis in stubs/abstract bodies
