; Coverage configuration for the backend test suite.
;
; The suite's contract (see docs/BACKEND.md → "Testing"):
;   `pytest` from backend/ runs everything AND enforces the coverage gate.
; The fail_under=90 gate below applies to the COMBINED total only. Branch
; coverage is surfaced per-line in the term-missing report, but it is not
; separately gated — a branch regression can pass CI while branches sit
; below 90% (the combined total is the enforceable floor).
;
; The gate is intentionally in fail_under here, not in pytest.ini addopts:
; `pytest --cov-fail-under=0` still works for a quick local iteration.

[run]
branch = True
source = app

[report]
fail_under = 90
show_missing = True
skip_covered = True
sort = Miss
exclude_lines =
    pragma: no cover
    if __name__ == "__main__":
    if TYPE_CHECKING:
    \.\.\.  ; ellipsis in stubs/abstract bodies
