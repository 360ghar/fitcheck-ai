# ============================================================================
# FitCheck AI Backend - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values

# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=fitcheck-images

# Pinecone Vector Database
# Get your API key from: Pinecone Console > API Keys
PINECONE_API_KEY=
PINECONE_INDEX_NAME=fitcheck-items
PINECONE_DIMENSION=768

# ============================================================================
# AI Provider Configuration
# ============================================================================
# Supports multiple providers: OpenAI, custom OpenAI-compatible proxy, or
# native Gemini. Users can configure their own keys in the app, or use system
# defaults below.
#
# --- PRODUCTION REQUIRED (railway env) ---
# These three are easy to miss and break things silently at request time:
#   AI_ENCRYPTION_KEY   - MUST be set (openssl rand -hex 32). Empty in prod
#                         means saving any user AI key raises AIServiceError.
#   FRONTEND_URL        - MUST be https://www.fitcheckaiapp.com in prod.
#                         Password-reset email links use it verbatim.
#   AI_VISION_API_URL   - Leave BLANK to inherit AI_CHAT_API_URL. Do NOT set
#                         to https://generativelanguage.googleapis.com - that
#                         host is not OpenAI-compatible and every vision
#                         request will 404. The same Gemini models are
#                         reachable through the Agnes gateway (AI_CHAT_API_URL)
#                         - or natively via AI_DEFAULT_PROVIDER=gemini below,
#                         which needs no per-leg URL at all.
# The backend logs these as config issues at startup; check the log drain.

# Default Provider: openai | custom | gemini
AI_DEFAULT_PROVIDER=custom

# AI_GEMINI_API_KEY is dual-purpose: server-side embeddings (google-genai SDK,
# AI_GEMINI_EMBEDDING_MODEL) AND the native chat/vision/image provider below
# (only used when AI_DEFAULT_PROVIDER=gemini, or a user selects Gemini via
# BYOK settings). Get a key from: Google AI Studio > API Keys.
#
# IMPORTANT - do not confuse these with the AI_VISION_*/AI_CHAT_* vars above:
# AI_VISION_MODEL (etc.) configures the Agnes/OpenAI-compatible leg; the
# AI_GEMINI_* vars below configure the SEPARATE native-Gemini leg. Setting a
# Gemini model name on the wrong one is exactly the misconfiguration that
# caused the original 401/fallback production bug this file's comments above
# already warn about - the two are not interchangeable.
AI_GEMINI_API_KEY=
AI_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_GEMINI_CHAT_MODEL=gemini-3.6-flash
AI_GEMINI_VISION_MODEL=gemini-3.6-flash
AI_GEMINI_VISION_FALLBACK_MODEL=
AI_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_GEMINI_IMAGE_FALLBACK_MODEL=

# OpenAI Configuration
# Get your API key from: OpenAI Platform > API Keys
AI_OPENAI_API_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_OPENAI_CHAT_MODEL=gpt-4o
AI_OPENAI_VISION_MODEL=gpt-4o
AI_OPENAI_IMAGE_MODEL=dall-e-3

# Custom Provider (OpenAI-compatible). Default: Agnes AI for chat, vision, images.
# Get a key from: https://platform.agnes-ai.com
#
# Per-leg scheme: each of chat / vision / vision-fallback / image / image-
# fallback can have its OWN url+key+model. Per-leg url/key falls back to its
# parent when blank: vision -> chat; vision_fallback -> vision; image -> chat;
# image_fallback -> image. A single-host setup only needs the AI_CHAT_* trio.
AI_CHAT_API_URL=https://apihub.agnes-ai.com/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=agnes-2.5-flash

# Vision primary -> fallback (fallback retries once after a retryable failure)
#
# AI_VISION_PROVIDER: custom | gemini
#   gemini (default) - the vision leg's PRIMARY call goes straight to Google's
#     native API (not through Agnes), falling back to AI_VISION_FALLBACK_MODEL
#     below on ANY failure (not just retryable ones - a Gemini safety-block or
#     bad-request error still tries the fallback, since it's a different vendor
#     that may succeed where Gemini refused). Requires AI_GEMINI_API_KEY to be
#     set. Under this mode AI_VISION_MODEL is read as a GEMINI model name and
#     WINS over AI_GEMINI_VISION_MODEL (which is ignored) - and AI_VISION_API_URL
#     must stay blank, since it becomes dead config once the leg is redirected
#     (config_health.py flags a non-blank value here as a startup error).
#   custom - vision stays OpenAI-compatible via AI_VISION_API_URL, same as
#     chat/image below. Use for local dev without a Google AI Studio key.
# Default is "gemini" (Gemini-primary, Agnes-fallback). Override to "custom"
# only for local dev without a Google AI Studio key configured.
AI_VISION_PROVIDER=gemini
AI_VISION_API_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=gemini-3.6-flash
AI_VISION_FALLBACK_API_URL=
AI_VISION_FALLBACK_API_KEY=
AI_VISION_FALLBACK_MODEL=agnes-2.5-flash

# Image primary -> fallback
AI_IMAGE_API_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=agnes-image-2.1-flash
AI_IMAGE_FALLBACK_API_URL=
AI_IMAGE_FALLBACK_API_KEY=
AI_IMAGE_FALLBACK_MODEL=agnes-image-2.0-flash
# "chat" = response_modalities on /chat/completions | "images" = /images/generations
AI_IMAGE_API_STYLE=images

# Max output tokens per AI call. gemini-3.6-flash caps at 64K output, the
# Agnes gateway (agnes-2.5-flash / agnes-3.5-pro-alpha) at 65.5K. 32K is a
# safe default well under both; raise it only if you see responses truncated
# with "finish_reason=length / MAX_TOKENS".
AI_MAX_OUTPUT_TOKENS=32768

# Rate Limits (per user per day)
AI_DAILY_EXTRACTION_LIMIT=100
AI_DAILY_GENERATION_LIMIT=50
AI_DAILY_EMBEDDING_LIMIT=500

# Concurrency caps for the batch extract+generate pipeline (per-image vision
# extraction and per-item product-image generation) and the outfit-variation
# fan-out. PROCESS-WIDE: shared across ALL concurrent jobs on this worker,
# NOT per-job. Each in-flight request holds a multi-MB base64 buffer and
# shared AI gateways can 429/503 under high parallelism, so raise cautiously.
AI_EXTRACTION_CONCURRENCY=30
AI_GENERATION_CONCURRENCY=30

# Outfit generation downloads each selected item's stored image server-side and
# sends it to the image model as a labelled garment reference next to the
# avatar, so generated outfits reproduce the real garments instead of inventing
# lookalikes. Garment references are downscaled to this longest edge (the
# avatar keeps the larger 1568px default used elsewhere).
AI_OUTFIT_ITEM_REFERENCE_MAX_EDGE=768
# Max garment reference images sent per outfit generation, and how many
# may be downloaded concurrently.
AI_OUTFIT_ITEM_REFERENCE_MAX_IMAGES=12
AI_OUTFIT_ITEM_REFERENCE_DOWNLOAD_CONCURRENCY=8
# Max items allowed in a single outfit generation request.
AI_MAX_OUTFIT_ITEMS=100

# Encryption key for storing user API keys (generate with: openssl rand -hex 32)
AI_ENCRYPTION_KEY=

# Application Settings (Optional)
DEBUG=false
FRONTEND_URL=http://localhost:3000
ENABLE_SOCIAL_IMPORT=true

# Gamification (streaks / achievements / leaderboard).
#
# Default is deliberately the OPPOSITE of ENABLE_SOCIAL_IMPORT above: OFF.
# Nothing in the backend ever WRITES user_streaks or user_achievements, so with
# it on every user sees a permanent 0-day streak and an all-zero leaderboard.
#
# When false the gamification ROUTES STAY MOUNTED and return zeroed 200
# responses -- they do NOT 404. The shipped Flutter dashboard runs an unguarded
# Future.wait([fetchDashboard(), fetchStreak()]), so a 404 on /streak blanks the
# whole home screen permanently. Do not "simplify" this to an unmounted router.
# Also gates the user_streaks/user_achievements tables in the /ready schema
# check (GAMIFICATION_TABLES in app/main.py).
#
# Keep in step with the web flag VITE_ENABLE_GAMIFICATION (frontend/.env.example).
ENABLE_GAMIFICATION=false

SOCIAL_IMPORT_MAX_CONCURRENT_JOBS=1
SOCIAL_IMPORT_MAX_PHOTOS_PER_JOB=2000
SOCIAL_IMPORT_AUTH_SESSION_TTL_MINUTES=120
SOCIAL_IMPORT_DISCOVERY_PAGE_SIZE=50
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=

# CORS Origins (comma-separated list)
BACKEND_CORS_ORIGINS=https://www.fitcheckaiapp.com,https://fitcheckaiapp.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Stripe Configuration
# Get your keys from: Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Transactional Email (Resend) - used by scripts/grant_free_pro_month.py
# Get your API key from: https://resend.com/api-keys
# FROM_EMAIL's domain MUST be verified in Resend or sends will 401.
RESEND_API_KEY=
FROM_EMAIL=FitCheck AI <team@fitcheckaiapp.com>
